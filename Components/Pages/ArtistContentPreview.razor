@page "/internal/artist-content/{Id:long}"
@inject LibraryRepository Repository
@inject IWebHostEnvironment Environment

<PageTitle>Biography review — Aneed Static System</PageTitle>
<section class="content-section page">
    <a href="@($"/artists/{Id}")" class="text-link">← Back to artist</a>
    <h1>Biography review</h1>
    @if (!Environment.IsDevelopment())
    {
        <p class="notice">This preview is not available.</p>
    }
    else if (error is not null)
    {
        <p class="notice">@error</p>
    }
    else if (draft is not null)
    {
        <span class="eyebrow">LOCAL REVIEW ONLY — NOT PUBLISHED</span>
        <h2>@draft.ArtistName</h2>
        <p class="muted">Status: @draft.ReviewStatus</p>
        @if (editorial is not null)
        {
            <h3>Aneed rewrite — @editorial.Status</h3>
            <p class="muted">Generated by @editorial.Model · prompt @editorial.PromptVersion</p>
            <div class="prose" style="white-space: pre-wrap">@editorial.Body</div>
            <p class="muted">@editorial.LicenseNotes</p>
        }
        else
        {
            <p class="muted">No Aneed editorial draft yet. Run the enrichment worker with --rewrite.</p>
        }
        <h3>Original Wikipedia source extract</h3>
        <div class="prose" style="white-space: pre-wrap">@draft.Summary</div>
        <h3>Attribution and rights</h3>
        <p>@draft.LicenseNotes</p>
        @if (!string.IsNullOrWhiteSpace(draft.SourceUrl))
        {
            <p>Source: <a href="@draft.SourceUrl" target="_blank" rel="noopener noreferrer">@draft.SourceUrl</a></p>
        }
        <p class="muted">Read-only preview. Approval and publication are deliberately not enabled yet.</p>
    }
</section>

@code {
    [Parameter] public long Id { get; set; }

    private ArtistContentDraft? draft;
    private ArtistEditorialDraft? editorial;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        draft = null;
        editorial = null;
        error = null;

        if (!Environment.IsDevelopment())
        {
            error = "Preview not available.";
            return;
        }

        if (!Repository.Configured)
        {
            error = "PostgreSQL catalog is not configured.";
            return;
        }

        try
        {
            draft = await Repository.ArtistContentPreview(Id);
            editorial = await Repository.ArtistEditorialPreview(Id);
            if (draft is null)
                error = "No biography draft found for this artist.";
        }
        catch (Npgsql.NpgsqlException)
        {
            error = "Couldn't retrieve the draft from PostgreSQL.";
        }
    }
}
