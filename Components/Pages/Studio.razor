@page "/studio"
@using AneedWeb.Services
@using AneedWeb.Djs
@implements IDisposable
@inject DjGroupRoom Room
@inject SamClapSchemaService ClapSchema

<PageTitle>DJ Group Rehearsal</PageTitle>
<h1>Aneed DJ group rehearsal</h1>
<p>Eight fictional DJs, one shared studio conversation. Development-only experiment; no listeners or database yet.</p>
<p class="text-muted">Rehearsal model: <code>@Room.ModelName</code></p>

@if (!Playback.Enabled)
{
    <p role="status">Automatic DJ conversations are enabled only in Development.</p>
}
else
{
    var session = Playback.Snapshot();
    <section class="card p-3 mb-3" aria-label="Current SAM playback">
        <h2 class="h5">Now playing</h2>
        @if (session.Broadcast.Current is { } current)
        {
            <p class="mb-1"><strong>Artist:</strong> @current.Artist</p>
            <p class="mb-1"><strong>Song:</strong> @current.Title</p>
            <p class="mb-1"><strong>SAM song ID:</strong> @(current.SamSongId?.ToString() ?? "Unavailable")</p>
            <p class="mb-1"><strong>AneedId:</strong> @(session.MusicIntelligence?.AneedId?.ToString() ?? "Resolving")</p>
        }
        else
        {
            <p class="mb-1">Waiting for a fresh SAM playback event.</p>
        }
        <p class="mb-0"><strong>Session:</strong> @session.Status</p>
        @if (!string.IsNullOrWhiteSpace(session.Message))
        {
            <p class="text-muted mb-0">@session.Message</p>
        }
        @if (session.Broadcast.IsStale && !string.IsNullOrWhiteSpace(session.Broadcast.Error))
        {
            <p role="status" class="text-muted mb-0">SAM refresh unavailable: @session.Broadcast.Error</p>
        }
    </section>

    @if (session.MusicIntelligence is { } analysis)
    {
        <section class="card p-3 mb-3" aria-label="Music Intelligence">
            <h2 class="h5">Music Intelligence</h2>
            <p class="mb-1"><strong>CLAP match:</strong> @(analysis.ClapMatchFound ? "Verified" : "Unavailable")</p>
            @if (analysis.Descriptions.Count > 0)
            {
                <ul>
                    @foreach (var description in analysis.Descriptions)
                    {
                        <li>@description.Text <span class="text-muted">(similarity @description.Similarity.ToString("0.0000"))</span></li>
                    }
                </ul>
            }
            else
            {
                <p class="mb-1">No CLAP descriptions are available; the conversation will use SAM metadata.</p>
            }
            @if (!string.IsNullOrWhiteSpace(analysis.Error))
            {
                <p class="text-muted mb-0">@analysis.Error</p>
            }
        </section>
    }

    <div class="mb-3">
        <button type="button" class="btn btn-outline-secondary me-2" @onclick="CheckClapSchemaAsync" disabled="@busy">
            Check SAM PostgreSQL CLAP schema
        </button>
        @if (!string.IsNullOrWhiteSpace(clapStatus))
        {
            <p role="status" class="mt-2">@clapStatus</p>
        }

        <button type="button" class="btn btn-primary me-2" @onclick="RunAsync" disabled="@(busy || !Room.ApiKeyConfigured)">
            @(busy ? "DJs are talking…" : "Let the DJs talk (3 turns)")
        </button>
        <button type="button" class="btn btn-outline-primary me-2" @onclick="RunCurrentSongAsync" disabled="@(busy || !Room.ApiKeyConfigured)">
            Rehearse with current song + CLAP
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Reset" disabled="@busy">
            Start over
        </button>
    </div>
    @if (!string.IsNullOrEmpty(error))
    {
        <section class="card p-3 mb-3" aria-label="Development playback schedule">
            <h2 class="h5">Development schedule diagnostics</h2>
            <p class="mb-1"><strong>Playback identity:</strong> SAM @(session.Broadcast.Current?.SamSongId?.ToString() ?? "Unavailable"), start @(session.PlaybackStarted?.ToLocalTime().ToString("HH:mm:ss") ?? "Unavailable") @(session.PlaybackStartEstimated ? "(estimated at detection)" : "(SAM timestamp)")</p>
            <p class="mb-1"><strong>Duration:</strong> @session.Duration.TotalSeconds.ToString("0") seconds @(session.DurationEstimated ? "(estimated)" : "(available data)")</p>
            <p class="mb-2"><strong>Elapsed:</strong> @session.Elapsed.ToString(@"hh\:mm\:ss")</p>
            @foreach (var turn in session.Turns)
            {
                <p class="mb-1">@turn.Speaker — scheduled @turn.ScheduledAt.ToLocalTime().ToString("HH:mm:ss"); actual @(turn.ActualAt?.ToLocalTime().ToString("HH:mm:ss") ?? "pending"); @turn.Status</p>
            }
            @if (Playback.RoomDiagnosticsSnapshot() is { Count: > 0 } diagnostics)
            {
                @foreach (var diagnostic in diagnostics)
                {
                    <p class="mb-1">Turn @diagnostic.Turn @diagnostic.Speaker; response @diagnostic.ResponseStatus; output tokens @(diagnostic.OutputTokens?.ToString() ?? "unavailable"); incomplete reason @(diagnostic.IncompleteReason ?? "none"); usable text @(diagnostic.UsableTextReturned is null ? "pending" : diagnostic.UsableTextReturned.Value ? "yes" : "no").</p>
                }
            }
        </section>
    }

    @if (session.Turns.FirstOrDefault(turn => turn.Status == "Scheduled") is { } nextTurn && session.Status is "Scheduled" or "Resolving song context")
    {
        <p role="status">@(session.Status == "Resolving song context" ? "Preparing song context…" : $"Next speaker: {nextTurn.Speaker} at {nextTurn.ScheduledAt.ToLocalTime():HH:mm:ss}")</p>
    }

    <section aria-label="Automated DJ conversation" aria-live="polite" class="container">
        @if (session.Lines.Count == 0)
        {
            <p>Waiting for a new SAM playback event. The DJs will begin automatically when one is detected.</p>
        }
        @foreach (var line in session.Lines)
        {
            <article class="card mb-2 p-3">
                <div class="dj-group-message">
                    <div class="dj-group-avatar" aria-hidden="true">
                        <span>@line.Speaker[..1]</span>
                        <img src="@DjProfiles.Get(line.DjId).ImagePath" alt="" loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="dj-group-message-body">
                        <strong>@line.Speaker</strong>
                        <p class="mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere">@line.Text</p>
                    </div>
                </div>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<DjGroupRoom.GroupLine> lines = [];
    private bool busy;
    private string? clapStatus;
    private string? error;
    private Broadcast nowPlaying = new(false, null, [], "SAM status has not been loaded yet.");
    private MusicIntelligence musicIntelligence = MusicIntelligence.Unavailable(null, "Music analysis has not been loaded yet.");
    private readonly CancellationTokenSource lifetimeCts = new();

    protected override async Task OnInitializedAsync()
    {
        Room.Changed += OnRoomChanged;
        RefreshConversation();
        await RefreshNowPlayingAsync();
    }

    private void RefreshConversation()
    {
        lines = Room.Snapshot();
        busy = Room.IsRunning;
    }

    private async Task RefreshNowPlayingAsync()
    {
        nowPlaying = await BroadcastService.Get();
        musicIntelligence = MusicIntelligence.Unavailable(nowPlaying.Current?.SamSongId, "Analysis will be loaded when the rehearsal starts.");
    }

    private void OnRoomChanged() => _ = InvokeAsync(() =>
    {
        RefreshConversation();
        StateHasChanged();
    });

    private async Task RunAsync()
    {
        error = null;
        try
        {
            if (nowPlaying.IsStale || nowPlaying.Current is null || nowPlaying.Current.SamSongId is null or <= 0)
                throw new InvalidOperationException(nowPlaying.Error ?? "Current SAM song could not be verified. Fix the history source before starting DJ conversation.");

            musicIntelligence = await ClapAnalysis.GetForSamSongAsync(nowPlaying.Current.SamSongId.Value, lifetimeCts.Token);
            var musicContext = VerifiedMusicContext.Create(nowPlaying.Current, musicIntelligence);
            await Room.RunThreeTurnsAsync(musicContext, lifetimeCts.Token);
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            error = "The rehearsal was cancelled. Start it again when ready.";
        }
        catch (Exception)
        {
            error = "The DJs couldn't finish this rehearsal. Try again.";
        }
        finally
        {
            RefreshConversation();
        }
    }

    private async Task RunCurrentSongAsync()
    {
        error = null;
        try { await Room.RunCurrentSongAsync(lifetimeCts.Token); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (OperationCanceledException) { error = "The rehearsal was cancelled."; }
        catch (Exception) { error = "The music rehearsal could not finish. Check the server logs."; }
        finally { Refresh(); }
    }

    private async Task CheckClapSchemaAsync()
    {
        try { clapStatus = await ClapSchema.InspectAsync(lifetimeCts.Token); }
        catch (Exception) { clapStatus = "Schema check failed; inspect application logs."; }
    }

    private void Reset()
    {
        Playback.Changed += OnPlaybackChanged;
    }

    private void OnPlaybackChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Playback.Changed -= OnPlaybackChanged;
}