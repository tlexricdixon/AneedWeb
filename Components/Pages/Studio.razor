@page "/studio"
@using AneedWeb.Services
@using AneedWeb.Djs
@implements IDisposable
@inject DjGroupRoom Room
@inject SamClapSchemaService ClapSchema
@inject BroadcastService Broadcast

<PageTitle>DJ Group Rehearsal</PageTitle>
<h1>Aneed DJ group rehearsal</h1>
<p>Eight fictional DJs, one shared studio conversation. Development-only experiment; no listeners or database yet.</p>
<p class="text-muted">Rehearsal model: <code>@Room.ModelName</code></p>

@if (!Room.Enabled)
{
    <p role="alert">This rehearsal is available only in the development environment.</p>
}
else
{
    @if (!Room.ApiKeyConfigured)
    {
        <p role="alert" class="text-danger">@Room.ConfigurationDiagnostic</p>
    }
    <section class="mb-3" aria-label="SAM now playing">
        <strong>SAM now playing:</strong>
        @if (nowPlaying is not null)
        {
            <span>@nowPlaying.Artist — @nowPlaying.Title</span>
            <small class="text-muted ms-2">SAM ID: @nowPlaying.SamSongId</small>
        }
        else
        {
            <span>Not loaded</span>
        }
        <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="RefreshNowPlayingAsync" disabled="@busy">
            Refresh SAM song
        </button>
    </section>
    <div class="mb-3">
        <button type="button" class="btn btn-outline-secondary me-2" @onclick="CheckClapSchemaAsync" disabled="@busy">
            Check SAM PostgreSQL CLAP schema
        </button>
        @if (!string.IsNullOrWhiteSpace(clapStatus))
        {
            <p role="status" class="mt-2">@clapStatus</p>
        }

        <button type="button" class="btn btn-primary me-2" @onclick="RunAsync" disabled="@(busy || !Room.ApiKeyConfigured)">
            @(busy ? "DJs are talking…" : "Let the DJs talk (3 turns)")
        </button>
        <button type="button" class="btn btn-outline-primary me-2" @onclick="RunSongOnlyAsync" disabled="@(busy || !Room.ApiKeyConfigured)">
            Let the DJs discuss the SAM song (3 turns)
        </button>
        <button type="button" class="btn btn-outline-primary me-2" @onclick="RunCurrentSongAsync" disabled="@(busy || !Room.ApiKeyConfigured)">
            Rehearse with current song + CLAP
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Reset" disabled="@busy">
            Start over
        </button>
    </div>
    @if (!string.IsNullOrEmpty(error))
    {
        <p role="alert" class="text-danger">@error</p>
    }
    <section aria-label="Shared DJ studio conversation" aria-live="polite" class="container">
        @if (lines.Count == 0)
        {
            <p>Hit the button and Kathleen, Lexi, Vesper and the others will begin a studio conversation.</p>
        }
        @foreach (var line in lines)
        {
            <article class="card mb-2 p-3">
                <div class="dj-group-message">
                    <div class="dj-group-avatar" aria-hidden="true">
                        <span>@line.Speaker[..1]</span>
                        <img src="@DjProfiles.Get(line.DjId).ImagePath"
                             alt="" loading="lazy"
                             onerror="this.style.display='none'" />
                    </div>
                    <div class="dj-group-message-body">
                        <strong>@line.Speaker</strong>
                        <p class="mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere">@line.Text</p>
                    </div>
                </div>
            </article>
        }
    </section>
}

@code {
    private IReadOnlyList<DjGroupRoom.GroupLine> lines = [];
    private bool busy;
    private Track? nowPlaying;
    private string? clapStatus;
    private string? error;
    private readonly CancellationTokenSource lifetimeCts = new();

    protected override void OnInitialized()
    {
        Room.Changed += OnRoomChanged;
        Refresh();
    }

    private void Refresh()
    {
        lines = Room.Snapshot();
        busy = Room.IsRunning;
    }

    private void OnRoomChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private async Task RunAsync()
    {
        error = null;
        try { await Room.RunThreeTurnsAsync(lifetimeCts.Token); }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            error = "The rehearsal was cancelled. Start it again when ready.";
        }
        catch (Exception)
        {
            error = "The DJs couldn't finish this rehearsal. Try again.";
        }
        finally { Refresh(); }
    }

    private async Task RefreshNowPlayingAsync()
    {
        var snapshot = await Broadcast.Get();
        nowPlaying = snapshot.Current;
        if (nowPlaying is null) error = "Could not read current SAM track. Check ANEED_SAM_HISTORY_URL or the local history file.";
        else error = null;
    }

    private async Task RunSongOnlyAsync()
    {
        error = null;
        try { await Room.RunSongOnlyAsync(lifetimeCts.Token); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (OperationCanceledException) { error = "The rehearsal was cancelled."; }
        catch (Exception) { error = "The current-song rehearsal could not finish. Check the server logs."; }
        finally { await RefreshNowPlayingAsync(); Refresh(); }
    }

    private async Task RunCurrentSongAsync()
    {
        error = null;
        try { await Room.RunCurrentSongAsync(lifetimeCts.Token); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        catch (OperationCanceledException) { error = "The rehearsal was cancelled."; }
        catch (Exception) { error = "The music rehearsal could not finish. Check the server logs."; }
        finally { Refresh(); }
    }

    private async Task CheckClapSchemaAsync()
    {
        try { clapStatus = await ClapSchema.InspectAsync(lifetimeCts.Token); }
        catch (Exception) { clapStatus = "Schema check failed; inspect application logs."; }
    }

    private void Reset()
    {
        Room.Reset();
        Refresh();
        error = null;
    }

    public void Dispose()
    {
        Room.Changed -= OnRoomChanged;
        lifetimeCts.Cancel();
        lifetimeCts.Dispose();
    }
}
