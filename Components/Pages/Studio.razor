@page "/studio"
@using AneedWeb.Services
@using AneedWeb.Djs
@implements IDisposable
@inject DjGroupRoom Room
@inject DjPlaybackCoordinator Playback

<PageTitle>DJ Studio</PageTitle>
<h1>Aneed DJ Studio</h1>
<p><a href="/studio/now-playing-lab">Open the Now Playing AI lab</a> (Development only)</p>
<p>Development-only automatic DJ conversation based on current SAM playback.</p>
<p class="text-muted">Model: <code>@Room.ModelName</code></p>

@if (!Playback.Enabled)
{
    <p role="status">Automatic DJ conversations are enabled only in Development.</p>
}
else
{
    var session = Playback.Snapshot();
    <section class="card p-3 mb-3" aria-label="Current SAM playback">
        <h2 class="h5">Now playing</h2>
        @if (session.Broadcast.Current is { } current)
        {
            <p class="mb-1"><strong>Artist:</strong> @current.Artist</p>
            <p class="mb-1"><strong>Song:</strong> @current.Title</p>
            <p class="mb-1"><strong>SAM song ID:</strong> @(current.SamSongId?.ToString() ?? "Unavailable")</p>
            <p class="mb-1"><strong>AneedId:</strong> @(session.MusicIntelligence?.AneedId?.ToString() ?? "Unavailable or resolving")</p>
        }
        else
        {
            <p class="mb-1">Waiting for a fresh SAM playback event.</p>
        }
            <p class="mb-0"><strong>Session:</strong> @session.Status</p>
            @if (!Room.ApiKeyConfigured)
            {
                <p role="status" class="text-muted mb-0">@Room.ConfigurationDiagnostic</p>
            }
        @if (!string.IsNullOrWhiteSpace(session.Message))
        {
            <p class="text-muted mb-0">@session.Message</p>
        }
        @if (session.Broadcast.IsStale && !string.IsNullOrWhiteSpace(session.Broadcast.Error))
        {
            <p role="status" class="text-muted mb-0">SAM refresh unavailable: @session.Broadcast.Error</p>
        }
    </section>

    @if (session.MusicIntelligence is { } analysis)
    {
        <section class="card p-3 mb-3" aria-label="Music Intelligence">
            <h2 class="h5">Music Intelligence</h2>
            <p class="mb-1"><strong>AneedId:</strong> @(analysis.AneedId?.ToString() ?? "Missing")</p>
            <p class="mb-1"><strong>CLAP analysis version:</strong> @(analysis.ClapVersion ?? "Missing")</p>
            <p class="mb-1"><strong>CLAP data source:</strong> @(analysis.ClapDataSource ?? "Missing")</p>
            <p class="mb-1"><strong>Provenance:</strong> @(analysis.ClapProvenanceVerified ? "Verified against original embedding source identity and model/version" : "Not verified / legacy fallback / unavailable")</p>
            @if (analysis.Facets is { Count: > 0 } facets)
            {
                <h3 class="h6 mt-2">CLAP musical-similarity candidates</h3>
                @foreach (var facet in facets)
                {
                    <p class="mb-1"><strong>@facet.Name@(facet.Ambiguous == true ? " (ambiguous)" : ""):</strong>
                        @(facet.Top.Count == 0 ? "No candidates" : string.Join(", ", facet.Top.Select(candidate => candidate.Label)))
                        @if (facet.TopGapZ is { } gap)
                        {
                            <span class="text-muted">(top-gap indicator @gap.ToString("0.##"))</span>
                        }
                    </p>
                }
            }
            else
            {
                <p class="mb-1">CLAP v2.2 facets are missing or invalid.</p>
            }
            @if (analysis.MoodAxes is { Count: > 0 } axes)
            {
                <h3 class="h6 mt-2">Audio-only emotional signals</h3>
                <p class="mb-1">Relative model-derived indicators (not calibrated probabilities or psychological facts):</p>
                <ul>
                    @foreach (var axis in axes)
                    {
                        <li>@axis.Name: @(axis.RelativeSignal?.ToString("0.##") ?? "missing")@(axis.Ambiguous == true ? " (ambiguous)" : "")</li>
                    }
                </ul>
            }
            else
            {
                <p class="mb-1">Audio-only emotional signals are missing.</p>
            }
            @if (analysis.AudioFeatures is { } features)
            {
                <h3 class="h6 mt-2">Measured audio features</h3>
                <ul>
                    <li>Duration: @(features.DurationSeconds?.ToString("0.##") ?? "missing") seconds</li>
                    <li>Estimated BPM: @(features.EstimatedBpm?.ToString("0.##") ?? "missing")</li>
                    <li>Estimated key: @(features.EstimatedKey ?? "missing") (correlation @(features.KeyCorrelation?.ToString("0.##") ?? "missing"))</li>
                    <li>RMS mean/opening/closing: @(features.RmsMean?.ToString("0.####") ?? "missing") / @(features.RmsOpening20Seconds?.ToString("0.####") ?? "missing") / @(features.RmsClosing20Seconds?.ToString("0.####") ?? "missing")</li>
                    <li>Spectral centroid mean: @(features.SpectralCentroidMeanHz?.ToString("0.##") ?? "missing") Hz</li>
                    <li>Onsets per second: @(features.OnsetsPerSecond?.ToString("0.##") ?? "missing")</li>
                </ul>
                <p class="text-muted">BPM and key are estimates, not guaranteed musical facts.</p>
            }
            else
            {
                <p class="mb-1">Measured audio features are unavailable.</p>
            }
            @if (analysis.ClapDataSource?.StartsWith("Legacy", StringComparison.OrdinalIgnoreCase) == true && analysis.Descriptions.Count > 0)
            {
                <h3 class="h6 mt-2">Legacy CLAP fallback descriptions (not verified genres)</h3>
                <ul>
                    @foreach (var description in analysis.Descriptions)
                    {
                        <li>@description.Text</li>
                    }
                </ul>
            }
            @if (!string.IsNullOrWhiteSpace(analysis.Error))
            {
                <p class="text-muted mb-0">@analysis.Error</p>
            }
        </section>
    }

    var music = session.MusicIntelligence;
    var currentMusic = music?.SamSongId is { } songId && songId == session.Broadcast.Current?.SamSongId ? music : null;
    var lyricStatus = currentMusic?.LyricStatus;
    var included = currentMusic?.AneedId is { } id && session.Diagnostics.Any(d => d.AneedId == id && d.SamSongId == currentMusic.SamSongId && d.LyricsIncluded);
    <section class="card p-3 mb-3" aria-label="Lyrics Analysis">
        <h2 class="h5">Lyrics Analysis</h2>
        <p class="mb-1"><strong>Lyrics:</strong> @(lyricStatus?.State ?? "Not available")</p>
        <p class="mb-1"><strong>Analysis version:</strong> @(lyricStatus?.Version ?? "—")</p>
        <p class="mb-1"><strong>DJ prompt:</strong> @(included ? "Included" : "Not included")</p>
        @if (!included)
        {
            <p class="mb-0"><strong>Reason:</strong> @(lyricStatus?.Reason ?? (lyricStatus?.State == "Loaded" ? "No DJ prompt has included this interpretation yet." : currentMusic is null ? "Waiting for the current song context." : "Lyric lookup was not available for this song."))</p>
        }
    </section>

    @if (session.SelectedDjIds.Count > 0 || session.Turns.Count > 0 || !string.IsNullOrEmpty(session.Message))
    {
        <section class="card p-3 mb-3" aria-label="Development playback schedule">
            <h2 class="h5">Development schedule diagnostics</h2>
            <p class="mb-1"><strong>Playback identity:</strong> SAM @(session.Broadcast.Current?.SamSongId?.ToString() ?? "Unavailable"), start @(session.PlaybackStarted?.ToLocalTime().ToString("HH:mm:ss") ?? "Unavailable") @(session.PlaybackStartEstimated ? "(estimated at detection)" : "(SAM timestamp)")</p>
            <p class="mb-1"><strong>Duration:</strong> @session.Duration.TotalSeconds.ToString("0") seconds @(session.DurationEstimated ? "(estimated)" : "(available data)")</p>
            <p class="mb-2"><strong>Elapsed:</strong> @session.Elapsed.ToString(@"hh\:mm\:ss")</p>
            @if (session.SelectedDjIds.Count > 0)
            {
                <p class="mb-2"><strong>@session.SelectedDjIds.Count DJs in speaking order:</strong> @string.Join(", ", session.SelectedDjIds.Select(id => DjProfiles.Get(id).Name))</p>
            }
            @foreach (var turn in session.Turns)
            {
                <p class="mb-1">Turn @turn.Turn — @turn.Speaker; scheduled @turn.ScheduledAt.ToLocalTime().ToString("HH:mm:ss"); actual @(turn.ActualAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—"); @turn.Status</p>
            }
            @if (session.Diagnostics is { Count: > 0 } diagnostics)
            {
                @foreach (var diagnostic in diagnostics)
                {
                    <p class="mb-1">Turn @diagnostic.Turn @diagnostic.Speaker; response @diagnostic.ResponseStatus; output tokens @(diagnostic.OutputTokens?.ToString() ?? "unavailable"); incomplete reason @(diagnostic.IncompleteReason ?? "none"); usable text @(diagnostic.UsableTextReturned is null ? "pending" : diagnostic.UsableTextReturned.Value ? "yes" : "no").</p>
                }
            }
        </section>
    }

    @if (session.Turns.FirstOrDefault(turn => turn.Status == "Pending") is { } nextTurn && session.Status is "Scheduled" or "Resolving song context")
    {
        <p role="status">@(session.Status == "Resolving song context" ? "Preparing song context…" : $"Next speaker: {nextTurn.Speaker} at {nextTurn.ScheduledAt.ToLocalTime():HH:mm:ss}")</p>
    }

    <section aria-label="Automated DJ conversation" aria-live="polite" class="container">
        @if (session.Lines.Count == 0)
        {
            <p>Waiting for a new SAM playback event. The DJs will begin automatically when one is detected.</p>
        }
        @foreach (var line in session.Lines)
        {
            <article class="card mb-2 p-3">
                <div class="dj-group-message">
                    <div class="dj-group-avatar" aria-hidden="true">
                        <span>@line.Speaker[..1]</span>
                        <img src="@DjProfiles.Get(line.DjId).ImagePath" alt="" loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="dj-group-message-body">
                        <strong>@line.Speaker</strong>
                        <p class="mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere">@line.Text</p>
                    </div>
                </div>
            </article>
        }
    </section>
}

@code {
    protected override void OnInitialized()
    {
        Playback.Changed += OnPlaybackChanged;
    }

    private void OnPlaybackChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Playback.Changed -= OnPlaybackChanged;
}