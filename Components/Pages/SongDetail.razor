@page "/songs/{Id:long}"
@inject LibraryRepository Repository
<PageTitle>@title — Aneed Static System</PageTitle>
<section class="content-section page">
    <a href="/library" class="text-link">← Back to library</a>
    @if (error is not null)
    {
        <h1>@title</h1><p class="notice">@error</p>
    }
    else if (song is not null)
    {
        <div class="detail">
            <img src="@(song.Artwork ?? "/images/station.png")" alt="Song artwork" />
            <div>
                <span class="eyebrow">FROM THE LIBRARY / SONG</span>
                <h1>@song.Title</h1>
                <a class="text-link" href="/artists/@song.ArtistId">@song.Artist ↗</a>
                <p>@song.Album @song.Year</p>
                <dl class="song-facts">
                    @if (!string.IsNullOrWhiteSpace(song.Genre)) { <dt>Genre</dt><dd>@song.Genre</dd> }
                    @if (!string.IsNullOrWhiteSpace(song.Composer)) { <dt>Composer</dt><dd>@song.Composer</dd> }
                    @if (!string.IsNullOrWhiteSpace(song.Label)) { <dt>Label</dt><dd>@song.Label</dd> }
                    @if (!string.IsNullOrWhiteSpace(song.Isrc)) { <dt>ISRC</dt><dd>@song.Isrc</dd> }
                </dl>
                <section class="song-editorial" aria-label="Behind the song">
                    <h2>Behind the song</h2>
                    @if (analysis is not null)
                    {
                        <p class="prose">@analysis.Summary</p>
                        @if (analysis.Themes.Length > 0) { <p><strong>Themes:</strong> @string.Join(" · ", analysis.Themes)</p> }
                        @if (analysis.Emotions.Length > 0) { <p><strong>Mood:</strong> @string.Join(" · ", analysis.Emotions)</p> }
                        @if (!string.IsNullOrWhiteSpace(analysis.EmotionalArc)) { <p><strong>Emotional arc:</strong> @analysis.EmotionalArc</p> }
                    }
                    else if (analysisLoading) { <p role="status">Loading song interpretation…</p> }
                    else { <p class="prose">@(string.IsNullOrWhiteSpace(song.Description) ? "More about this song is coming." : song.Description)</p> }
                </section>
            </div>
        </div>
    }
</section>
@code {
    [Parameter] public long Id { get; set; }
    private Song? song;
    private PublishedSongAnalysis? analysis;
    private bool analysisLoading;
    private string title = "The music library";
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        song = null; analysis = null; analysisLoading = false; error = null;
        if (!Repository.Configured) { error = "The music library is getting connected. Please check back soon."; return; }
        try
        {
            song = (await Repository.Songs(id: Id)).FirstOrDefault();
            title = song?.Title ?? "Song not found";
            if (song is null) error = "This entry could not be found in the library.";
            else _ = LoadAnalysisAsync(Id);
        }
            catch (Microsoft.Data.SqlClient.SqlException) { error = "The library is temporarily unavailable."; }
    }
    private async Task LoadAnalysisAsync(long id)
    {
        analysisLoading = true;
        StateHasChanged();
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            var published = await Repository.SongAnalysis(id, cts.Token);
            if (Id == id) analysis = published;
        }
        catch (Exception ex) when (ex is Microsoft.Data.SqlClient.SqlException or InvalidOperationException or OperationCanceledException)
        {
            // Optional content must never block the song page.
        }
        finally
        {
            if (Id == id) { analysisLoading = false; StateHasChanged(); }
        }
    }
}
