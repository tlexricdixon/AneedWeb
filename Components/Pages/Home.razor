@page "/"
@implements IAsyncDisposable
@inject BroadcastService Broadcast
@inject LibraryRepository Library
<PageTitle>Aneed Static System — The signal is alive</PageTitle>
<section class="hero">
 <div class="hero-copy"><span class="eyebrow">INDEPENDENT RADIO / NO GENRE WALLS</span><h1>THE SIGNAL<br />IS <em>ALIVE.</em></h1><p>No genre walls. No safe little boxes.<br />Just the shadow, the smoke, and the songs<br class="desktop" /> that remember the fight.</p><div class="actions"><a class="button" href="#listen">▶ &nbsp; Listen live</a><a class="button secondary" href="/recently-played">Recently played ↗</a></div><div class="hero-note"><span class="red-dot"></span> A NEED STATIC SYSTEM <span>/</span> POWERED BY LIVE365</div></div>
 <div class="hero-art" role="img" aria-label="Aneed station dragon artwork in crimson shadows"></div>
 <div class="hero-number">01 / THE TRANSMISSION</div>
</section>
<section class="content-section broadcast-grid">
 <div class="now"><div class="section-heading"><span class="eyebrow">THE LIVE SIGNAL</span><span class="live-badge">@(state.Playing ? "● ON AIR" : "STATION")</span></div><h2>Now playing</h2>
 @if(state.Current is {} track) { <div class="now-track"><img src="@(track.Artwork ?? "/images/station.webp")" alt="Current track artwork" /><div><a class="now-title" href="@SongLink(track)">@track.Title</a><a class="muted" href="@ArtistLink(track)">@track.Artist</a><span class="eyebrow">@(Match(track)?.Album ?? "ANEED STATIC SYSTEM")</span></div></div> }
 else { <p>The next transmission is waiting. Tune in below.</p> }
 @if(state.Error is not null) { <p class="notice">@state.Error</p> }
 <div class="signal-line"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></div>
 <div><div class="section-heading"><div><span class="eyebrow">FRESH FROM THE AIRWAVES</span><h2>Recently played</h2></div><a href="/recently-played">View history ↗</a></div>@foreach(var recentTrack in state.Recent.Take(4)){ <TrackRow Item="recentTrack" Library="songs" /> }@if(state.Recent.Count==0){<p class="muted">Recent tracks will appear when Live365 updates.</p>}</div>
</section>
<section class="content-section catalog-entry" id="catalog">
 <span class="eyebrow">THE ANEED MUSIC LIBRARY</span>
 <h2>Find your next song.</h2>
 <form class="search-form" method="get" action="/library">
  <label for="home-search" class="sr-only">Search songs or artists</label>
  <input id="home-search" name="q" maxlength="200" placeholder="Search songs or artists…" />
  <button class="button" type="submit">Search ↗</button>
 </form>
 <h3>Browse artists A–Z</h3>
 <nav class="alphabet" aria-label="Browse artists alphabetically">
 @foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
 {
  <a href="@($"/artists?letter={letter}")">@letter</a>
 }
 </nav>
</section>
<section id="about" class="about content-section"><span class="eyebrow">THE SHADOW AND THE SMOKE</span><h2>A station for the songs<br />that <em>stay with you.</em></h2><p>Aneed Static System is independent internet radio with no genre walls. Old discoveries. New obsessions. Music that remembers the fight.</p><div id="contact"><a class="text-link" href="https://live365.com/station/Aneed-Static-System-a30355" target="_blank" rel="noopener">Find our station and contact links on Live365 ↗</a></div></section>
@code {
 private CancellationTokenSource stop=new(); private Task? polling;
 private Broadcast state=new(false,null,[],null); private List<Song> songs=[];
 private Song? Match(Track track)=>songs.FirstOrDefault(s=>s.Title.Equals(track.Title,StringComparison.OrdinalIgnoreCase)&&s.Artist.Equals(track.Artist,StringComparison.OrdinalIgnoreCase));
 private string SongLink(Track track)=>Match(track) is {} song ? $"/songs/{song.Id}" : "/library?q="+Uri.EscapeDataString(track.Title);
 private string ArtistLink(Track track)=>Match(track) is {} song ? $"/artists/{song.ArtistId}" : "/library?q="+Uri.EscapeDataString(track.Artist);
 protected override Task OnAfterRenderAsync(bool first){if(first)polling=Poll();return Task.CompletedTask;}
 private async Task Poll(){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));while(await timer.WaitForNextTickAsync(stop.Token)){state=await Broadcast.Get();if(Library.Configured)try{songs=await Library.BroadcastSongs(state.Current is {} current ? state.Recent.Prepend(current) : state.Recent);}catch(Microsoft.Data.SqlClient.SqlException){}await InvokeAsync(StateHasChanged);}}catch(OperationCanceledException){}}
 public async ValueTask DisposeAsync(){await stop.CancelAsync();if(polling is not null)await polling;stop.Dispose();}
 protected override async Task OnInitializedAsync(){state=await Broadcast.Get();if(Library.Configured){try{songs=await Library.BroadcastSongs(state.Current is {} current ? state.Recent.Prepend(current) : state.Recent);}catch(Microsoft.Data.SqlClient.SqlException){}}}
}
