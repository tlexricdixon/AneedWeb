@page "/library"
<PageTitle>Music library — Aneed Static System</PageTitle>
<section class="content-section page"><span class="eyebrow">DIG INTO THE SIGNAL</span><h1>The music library.</h1><p>Find a song. Discover an artist. Follow the thread.</p><form class="search-form" @onsubmit="Search" @onsubmit:preventDefault><label class="sr-only" for="search">Search songs and artists</label><input id="search" @bind="query" placeholder="Search songs or artists…" maxlength="200" /><button class="button" type="submit">Search ↗</button></form>
@if(busy){<p role="status">Searching the library…</p>}else if(error is not null){<p class="notice" role="status">@error</p>}else{<div class="library-results"><div><h2>Songs <small>@songs.Count</small></h2>@foreach(var song in songs){<div class="track-row"><img src="@(song.Artwork ?? "/images/station.png")" alt=""/><div><a class="track-title" href="/songs/@song.Id">@song.Title</a><a class="muted" href="/artists/@song.ArtistId">@song.Artist</a></div><span class="muted">@song.Album</span></div>}@if(songs.Count==0){<p class="muted">No matching songs.</p>}</div><div><h2>Artists <small>@artists.Count</small></h2>@foreach(var artist in artists){<a class="artist-card" href="/artists/@artist.Id">@artist.Name <span>↗</span></a>}@if(artists.Count==0){<p class="muted">No matching artists.</p>}</div></div><p class="muted">Up to 100 results per category. Refine your search to find more.</p>}</section>
