@page "/recently-played"
@implements IAsyncDisposable
@inject BroadcastService Broadcast
@inject LibraryRepository Repository
<PageTitle>Recently played — Aneed Static System</PageTitle>
<section class="content-section page"><span class="eyebrow">THE TRANSMISSION LOG</span><h1>Fresh from the airwaves.</h1><p>Currently playing and up to ten recent tracks from Live365. Times shown in UTC.</p>@if(state.Error is not null){<p class="notice">@state.Error</p>}@if(state.Current is {} current){<h2>Now playing</h2><TrackRow Item="current" Library="songs"/>}<h2>Recently played</h2>@foreach(var track in state.Recent){<TrackRow Item="track" Library="songs"/>}@if(state.Recent.Count==0){<p>No play history is available yet.</p>}</section>
@code{
 private Broadcast state=new(false,null,[],null);private List<Song> songs=[];private CancellationTokenSource stop=new();private Task? polling;
 protected override async Task OnInitializedAsync(){state=await Broadcast.Get();if(Repository.Configured)try{songs=await Repository.BroadcastSongs(state.Current is {} current ? state.Recent.Prepend(current) : state.Recent);}catch(Microsoft.Data.SqlClient.SqlException){}}
 protected override Task OnAfterRenderAsync(bool first){if(first)polling=Poll();return Task.CompletedTask;}
 private async Task Poll(){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));while(await timer.WaitForNextTickAsync(stop.Token)){state=await Broadcast.Get();if(Repository.Configured)try{songs=await Repository.BroadcastSongs(state.Current is {} current ? state.Recent.Prepend(current) : state.Recent);}catch(Microsoft.Data.SqlClient.SqlException){}await InvokeAsync(StateHasChanged);}}catch(OperationCanceledException){}}
 public async ValueTask DisposeAsync(){await stop.CancelAsync();if(polling is not null)await polling;stop.Dispose();}
}
