@page "/artists/{Id:long}"
@inject LibraryRepository Repository
<PageTitle>@title — Aneed Static System</PageTitle>
<section class="content-section page">
 <a href="/artists" class="text-link">← Artists A–Z</a>
 @if (error is not null) { <h1>@title</h1><p class="notice">@error</p> }
 else if (artist is not null)
 {
  <div class="detail">
   <img src="@(artist.Image ?? "/images/station.png")" alt="" />
   <div><span class="eyebrow">FROM THE LIBRARY / ARTIST</span><h1>@artist.Name</h1><p class="prose">@artist.Biography</p></div>
  </div>
  <h2>Albums in our library</h2>
  @foreach (var album in albums)
  {
   <a class="artist-card" href="@($"/artists/{Id}/albums/{Uri.EscapeDataString(album.Name)}")">
     @album.Name <span>@(album.Year?.ToString() ?? "") · @album.Tracks tracks ↗</span>
   </a>
  }
  @if(albums.Count == 0) { <p>No tagged albums are available for this artist.</p> }
  <h2>Songs in our library</h2>
  @foreach (var song in songs)
  {
   <div class="track-row"><div><a class="track-title" href="/songs/@song.Id">@song.Title</a><span class="muted">@song.Album</span></div></div>
  }
  @if (songs.Count == 100) { <p class="muted">Showing the first 100 songs. <a href="@("/library?q=" + Uri.EscapeDataString(artist.Name))">Search for more</a>.</p> }
 }
</section>
@code {
 [Parameter] public long Id { get; set; }
 private Artist? artist;
 private List<Song> songs = [];
 private List<(string Name, int Tracks, int? Year)> albums = [];
 private string title = "Artist";
 private string? error;
 protected override async Task OnParametersSetAsync()
 {
  artist = null; songs = []; albums = []; error = null;
  if (!Repository.Configured) { error = "The music library is getting connected."; return; }
  try
  {
   artist = (await Repository.Artists(id: Id)).FirstOrDefault();
   title = artist?.Name ?? "Artist not found";
   if (artist is null) { error = "Artist not found."; return; }
   albums = await Repository.ArtistAlbums(Id);
   songs = await Repository.Songs(artist: Id);
  }
   catch (Microsoft.Data.SqlClient.SqlException) { error = "The artist catalog is temporarily unavailable."; }
 }
}
