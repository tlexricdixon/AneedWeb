<div class="track-row"><img src="@(Item.Artwork ?? "/images/station.png")" alt="" loading="lazy" /><div><a class="track-title" href="@SongLink">@Item.Title</a><a class="muted" href="@ArtistLink">@Item.Artist</a></div><time datetime="@Item.Started?.ToString("O")">@(Item.Started?.ToUniversalTime().ToString("HH:mm") ?? "—") <small>UTC</small></time></div>
@code {
 [Parameter, EditorRequired] public Track Item { get; set; } = default!;
 [Parameter] public IReadOnlyList<Song> Library { get; set; } = [];
 private Song? Match=>Item.SamSongId is > 0 ? Library.FirstOrDefault(s=>s.Id==Item.SamSongId.Value) : null;
 private string SongLink=>Item.SamSongId is > 0 ? $"/songs/{Item.SamSongId.Value}" : "/library?q="+Uri.EscapeDataString(Item.Title);
 private string ArtistLink=>Match is {} s ? $"/artists/{s.ArtistId}" : "/library?q="+Uri.EscapeDataString(Item.Artist);
}
