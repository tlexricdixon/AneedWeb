<div class="track-row"><img src="@(Item.Artwork ?? "/images/station.webp")" alt="" loading="lazy" /><div><a class="track-title" href="@SongLink">@Item.Title</a><a class="muted" href="@ArtistLink">@Item.Artist</a></div><time datetime="@Item.Started?.ToString("O")">@(Item.Started?.ToUniversalTime().ToString("HH:mm") ?? "—") <small>UTC</small></time></div>
@code {
 [Parameter, EditorRequired] public Track Item { get; set; } = default!;
 [Parameter] public IReadOnlyList<Song> Library { get; set; } = [];
 private Song? Match=>Library.FirstOrDefault(s=>s.Title.Equals(Item.Title,StringComparison.OrdinalIgnoreCase)&&s.Artist.Equals(Item.Artist,StringComparison.OrdinalIgnoreCase));
 private string SongLink=>Match is {} s ? $"/songs/{s.Id}" : "/library?q="+Uri.EscapeDataString(Item.Title);
 private string ArtistLink=>Match is {} s ? $"/artists/{s.ArtistId}" : "/library?q="+Uri.EscapeDataString(Item.Artist);
}
